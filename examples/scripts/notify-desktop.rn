// A finished hook that reports through the desktop instead of the network, and
// shows the shapes the report can be read in.
//
// `cleaner::notify` is the app's own notification, so this works on every
// platform without knowing which one it is - and without `process`, which is
// opt-in because a script that shells out can delete outside the engine.

pub fn main() {
    cleaner::on_finished("report");
}

pub async fn report(run) {
    // Program by program, with the per-program numbers.
    let lines = [run.summary()];

    for entry in run.entries() {
        lines.push(entry.line());

        // Which categories ended up in this row.
        if entry.in_category("Cache") {
            cleaner::log(`${entry.program}: cache portion is ${entry.size()}`);
        }
    }

    // Everything cleaned under one category, if the whole run is too much.
    let cache = run.category("Cache");
    lines.push(format!("{} cache rows", cache.len()));

    // How long the run took, for the line that says whether this was a slow one.
    lines.push(format!("took {}s", run.duration()));

    cleaner::notify("Cross Cleaner", lines.join("\n"));

    // A short pause, so two notifications in a row do not overlap.
    time::sleep(time::Duration::from_millis(250)).await?;
}